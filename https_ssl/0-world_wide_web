#!/usr/bin/env bash
# Audits domain subdomains using dig and awk

check_subdomain() {
    local domain="$1"
    local subdomain="$2"
    local full_domain="${subdomain}.${domain}"

    dig "${full_domain}" | awk -v s="${subdomain}" '/ANSWER SECTION:/ {
        getline
        print "The subdomain " s " is a " $(NF-1) " record and points to " $NF
    }'
}

if [ -n "$2" ]; then
    check_subdomain "$1" "$2"
else
    check_subdomain "$1" "www"
    check_subdomain "$1" "lb-01"
    check_subdomain "$1" "web-01"
    check_subdomain "$1" "web-02"
fi
